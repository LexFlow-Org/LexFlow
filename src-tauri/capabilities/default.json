{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop frontend: local events, dialogs and notifications. Sidecars and file opening are only exposed through validated Rust commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-is-permission-granted",
    "notification:allow-show",
    "notification:allow-cancel",
    "notification:allow-get-pending",
    "notification:allow-get-active",
    "notification:allow-remove-active",
    "notification:allow-batch",
    "notification:allow-check-permissions",
    "notification:allow-permission-state"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ]
}
