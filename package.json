{
  "name": "lexflow",
  "version": "1.0.1",
  "description": "LexFlow — Gestionale studio legale con archivio locale cifrato",
  "author": "Pietro Longo",
  "private": true,
  "scripts": {
    "tauri": "npx @tauri-apps/cli",
    "dev": "npx @tauri-apps/cli dev",
    "build": "npm run build:mac",
    "build:mac": "npm run build:mac-arm && npm run build:mac-intel",
    "build:mac-arm": "npx @tauri-apps/cli build --target aarch64-apple-darwin --bundles dmg",
    "build:mac-intel": "npx @tauri-apps/cli build --target x86_64-apple-darwin --bundles dmg",
    "build:win": "powershell -NoProfile -File scripts/build-windows.ps1 -Bundle nsis",
    "build:all": "npx @tauri-apps/cli build",
    "build:me": "npm run build:mac",
    "android:init": "npx @tauri-apps/cli android init && python3 scripts/harden-android.py",
    "android:dev": "npx @tauri-apps/cli android dev",
    "android:build": "python3 scripts/harden-android.py && npx @tauri-apps/cli android build --apk",
    "android:build-aab": "python3 scripts/harden-android.py && npx @tauri-apps/cli android build --aab",
    "test:native-hardening": "python3 scripts/test-native-hardening.py",
    "license": "python3 scripts/generate_license_v2.py generate",
    "license:verify": "python3 scripts/generate_license_v2.py verify",
    "test:license": "python3 scripts/test-license-generator.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1"
  }
}
